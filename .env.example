# ─── Cyberdyne ────────────────────────────────────────────────────────────────
# Copy this file to `.env` and edit the values if you want to move the
# config or data folders outside the compose directory.
#
# Defaults point to `./config` and `./data` relative to this file.
#
# Example absolute paths:
#   CONFIG_DIR=/srv/cyberdyne/config
#   DATA_DIR=/srv/cyberdyne/data
#
# If you change CONFIG_DIR or DATA_DIR, also move the existing content
# (rsync -av ./config <new_CONFIG_DIR>/) before running `docker compose up`.
# `scripts/configure-base-urls.sh` keeps working the same way since it
# operates inside the containers, not on the host.

# Config directory (persistent). Each app stores its settings here.
CONFIG_DIR=./config

# Data directory (libraries + downloads).
DATA_DIR=./data
